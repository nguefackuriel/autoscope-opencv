__pycache__/
*.py[cod]
.venv/
venv/
.env
data/raw/
data/derived/
*.zip
# Benchmark results ARE committed: the COOL claim is worth exactly what its
# evidence is worth, and a judge cannot check a number that only ever existed
# on a terminated instance. Only the local scratch runs are ignored.
bench/results/local-*.json
bench/results/profile-local-*.json
.pytest_cache/
.DS_Store

src/*.egg-info/
.venv-train/
eval/results/*patches*.npz
eval/results/*.log
eval/results/*tiles*.npz
eval/results/*.pt
.venv-detect/
# Detector checkpoints: a Faster R-CNN epoch is ~160 MB and there are 20
# of them. The chosen weights go to ClearML artifacts, never into git.
models/frcnn/
models/yolo26/

# Terraform
infra/terraform/.terraform/
infra/terraform/.build/
infra/terraform/*.tfstate*
infra/terraform/terraform.tfvars
infra/terraform/.terraform.lock.hcl

# Built Lambda packages, never committed
infra/lambda/layers/python/*
!infra/lambda/layers/python/.gitkeep
infra/lambda/layers/*.zip
infra/lambda/agent/moves.py
eval/results/run_env.json
eval/results/colab_env.json

# The demo page pulls its frames from docs/figures/session at deploy time
# (infra/site/deploy.sh). A second copy here would be duplicate binary that can
# silently disagree with the committed one.
infra/site/fields/

# Ultralytics downloads a nano model at training start for its AMP check, and
# drops it in ./weights. Incidental, ~5 MB, and nothing depends on it being
# committed.
weights/
*.pt
